<!-- verification email, template version 1. All interpolated fields are
     rendered through Jinja2's mandatory autoescape (never string-built),
     per docs/notifications.md section 3. -->
<html>
  <body>
    <p>Hi,</p>
    <p>Thanks for registering for NutriApp with {{ email }}.</p>
    <p>Your verification code is: <strong>{{ verification_token }}</strong></p>
    <p>If you did not create this account, you can ignore this email.</p>
  </body>
</html>

