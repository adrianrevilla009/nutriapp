<!-- password-reset email, template version 1. Autoescaped per
     docs/notifications.md section 3. -->
<html>
  <body>
    <p>Hi,</p>
    <p>We received a request to reset the password for {{ email }}.</p>
    <p>Your reset code is: <strong>{{ reset_token }}</strong></p>
    <p>If you did not request this, you can ignore this email -- your password will not change.</p>
  </body>
</html>

