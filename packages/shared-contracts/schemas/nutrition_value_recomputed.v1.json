{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutriapp.internal/schemas/nutrition_value_recomputed.v1.json",
  "title": "NutritionValueRecomputed",
  "type": "object",
  "required": ["event_id", "aggregate_id", "event_type", "version", "occurred_at", "payload", "metadata"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "NutritionValueRecomputed" },
    "version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": [
        "user_id", "scope", "entry_id", "date", "macros", "micronutrients",
        "micronutrients_status", "is_estimated", "confidence_range",
        "formula_version", "reason", "recomputed_at"
      ],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "scope": { "enum": ["entry", "day"] },
        "entry_id": { "type": ["string", "null"], "format": "uuid" },
        "date": { "type": ["string", "null"], "format": "date" },
        "macros": {
          "type": "object",
          "required": ["calories_kcal", "protein_g", "carbs_g", "fat_g"],
          "properties": {
            "calories_kcal": { "type": "number" },
            "protein_g": { "type": "number" },
            "carbs_g": { "type": "number" },
            "fat_g": { "type": "number" }
          },
          "additionalProperties": false
        },
        "micronutrients": { "type": ["object", "null"] },
        "micronutrients_status": { "enum": ["available", "partial", "unavailable"] },
        "is_estimated": { "type": "boolean" },
        "confidence_range": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "additionalProperties": false
        },
        "formula_version": { "type": "string" },
        "reason": {
          "enum": ["food_entry_logged", "food_entry_corrected", "food_entry_deleted", "formula_correction"]
        },
        "recomputed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["correlation_id"],
      "properties": {
        "correlation_id": { "type": "string" },
        "causation_id": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
