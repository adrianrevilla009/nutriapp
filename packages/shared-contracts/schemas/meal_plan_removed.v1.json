{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutriapp.internal/schemas/meal_plan_removed.v1.json",
  "title": "MealPlanRemoved",
  "type": "object",
  "required": ["event_id", "aggregate_id", "event_type", "version", "occurred_at", "payload", "metadata"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "MealPlanRemoved" },
    "version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["plan_entry_id", "user_id", "removed_at"],
      "properties": {
        "plan_entry_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "removed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["correlation_id"],
      "properties": {
        "correlation_id": { "type": "string" },
        "causation_id": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
