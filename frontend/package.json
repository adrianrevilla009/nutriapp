{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "NutriApp frontend -- first cut: scaffold + E2E journey 1 (register -> log a food item from catalog search -> see macro/micro totals). See /plans/frontend/implementation-plan.md.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run tests/unit tests/integration --coverage",
    "test:e2e": "playwright test",
    "test:e2e:seed": "tsx tests/e2e/seed/seed.ts"
  },
  "dependencies": {
    "next": "15.5.25",
    "next-intl": "4.14.2",
    "react": "19.2.8",
