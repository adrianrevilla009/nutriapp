# Terraform working files — never commit state, plan files, or provider
# plugin caches. See docs/terraform-and-infrastructure.md section 6.
**/.terraform/
**/.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Bootstrap keeps state local by design (see bootstrap/README.md) — make
# doubly sure it never gets committed even though the pattern above
# already covers *.tfstate.
bootstrap/terraform.tfstate
bootstrap/terraform.tfstate.backup

# Per-environment backend config is generated locally from bootstrap
# outputs and contains an account-specific (not secret, but
# non-portable) bucket name — keep the example committed, not the real
# file.
environments/*/backend.hcl

# Local variable overrides (e.g. the operator's real IP for
# cluster_endpoint_public_access_cidrs) — never commit a real IP/CIDR
# tied to a person's location.
environments/*/terraform.tfvars.local

# Build artifact generated by the archive_file data source at
# plan/apply time — regenerated deterministically from
# lambda/scale_handler.py, never hand-edited or committed.
modules/scale-to-zero/lambda/*.zip
