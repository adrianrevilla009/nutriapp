# Root .env for local docker-compose. Copy to .env and adjust as needed.
# NEVER commit a real .env file — see .gitignore.

# --- identity-service ---
IDENTITY_SERVICE_DATABASE_URL=postgresql+asyncpg://identity_service:identity_service@identity-db:5432/identity_service
IDENTITY_SERVICE_REDIS_URL=redis://identity-redis:6379/0
IDENTITY_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
IDENTITY_JWT_PRIVATE_KEY_PATH=/run/secrets/identity_jwt_private_key.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=/run/secrets/identity_jwt_public_key.pem
IDENTITY_JWT_KEY_ID=identity-service-dev-key-1
# Shared secret notification-service presents when calling the internal
# reveal endpoint. Local dev only — production value comes from Secrets
# Manager (see infra/terraform/environments/dev/identity-service.tf).
IDENTITY_INTERNAL_REVEAL_CREDENTIAL=dev-internal-reveal-credential-change-me

# Postgres (identity-db container)
POSTGRES_DB=identity_service
POSTGRES_USER=identity_service
POSTGRES_PASSWORD=identity_service

# RabbitMQ management UI
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- catalog-service ---
CATALOG_SERVICE_DATABASE_URL=postgresql+asyncpg://catalog_service:catalog_service@catalog-db:5432/catalog_service
CATALOG_SERVICE_REDIS_URL=redis://catalog-redis:6379/0
CATALOG_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Register a free key at https://fdc.nal.usda.gov/api-key-signup.html for
# real ingestion; DEMO_KEY is heavily rate-limited and fine for local dev
# smoke-testing only, never for a real bulk run.
CATALOG_SERVICE_USDA_FDC_API_KEY=DEMO_KEY
CATALOG_SERVICE_USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
# Checked against food-recognition-service's X-Internal-Service-Credential
# header on GET /internal/v1/catalog/lookup (implementation plan Addendum
# 2). Local-dev value only -- production reads a Terraform-managed
# per-caller secret (infra/terraform/modules/secrets), never this value.
CATALOG_INTERNAL_LOOKUP_CREDENTIAL=local-dev-internal-lookup-credential

# Postgres (catalog-db container)
CATALOG_POSTGRES_DB=catalog_service
CATALOG_POSTGRES_USER=catalog_service
CATALOG_POSTGRES_PASSWORD=catalog_service

# --- nutrition-calculation-service ---
NUTRITION_CALCULATION_SERVICE_DATABASE_URL=postgresql+asyncpg://nutrition_calculation_service:nutrition_calculation_service@nutrition-db:5432/nutrition_calculation_service
NUTRITION_CALCULATION_SERVICE_REDIS_URL=redis://nutrition-redis:6379/0
NUTRITION_CALCULATION_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
NUTRITION_CALCULATION_SERVICE_IDENTITY_JWKS_URL=http://identity-service:8000/.well-known/jwks.json
NUTRITION_CALCULATION_SERVICE_PROFILE_SERVICE_BASE_URL=http://profile-service:8000
# Per-caller credential for profile-service's internal reveal-metrics
# endpoint (implementation plan Addendum 1) -- local dev only, production
# value comes from Secrets Manager.
NUTRITION_CALCULATION_SERVICE_PROFILE_REVEAL_CREDENTIAL=dev-profile-reveal-credential-change-me

# Postgres (nutrition-db container)
NUTRITION_POSTGRES_DB=nutrition_calculation_service
NUTRITION_POSTGRES_USER=nutrition_calculation_service
NUTRITION_POSTGRES_PASSWORD=nutrition_calculation_service
