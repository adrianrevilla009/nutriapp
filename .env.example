# Root .env for local docker-compose. Copy to .env and adjust as needed.
# NEVER commit a real .env file — see .gitignore.

# --- identity-service ---
IDENTITY_SERVICE_DATABASE_URL=postgresql+asyncpg://identity_service:identity_service@identity-db:5432/identity_service
IDENTITY_SERVICE_REDIS_URL=redis://identity-redis:6379/0
IDENTITY_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
IDENTITY_JWT_PRIVATE_KEY_PATH=/run/secrets/identity_jwt_private_key.pem
IDENTITY_JWT_PUBLIC_KEY_PATH=/run/secrets/identity_jwt_public_key.pem
IDENTITY_JWT_KEY_ID=identity-service-dev-key-1
# Shared secret notification-service presents when calling the internal
# reveal endpoint. Local dev only — production value comes from Secrets
# Manager (see infra/terraform/environments/dev/identity-service.tf).
IDENTITY_INTERNAL_REVEAL_CREDENTIAL=dev-internal-reveal-credential-change-me

# Postgres (identity-db container)
POSTGRES_DB=identity_service
POSTGRES_USER=identity_service
POSTGRES_PASSWORD=identity_service

# RabbitMQ management UI
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- diary-service ---
DIARY_SERVICE_DATABASE_URL=postgresql+asyncpg://diary_service:diary_service@diary-db:5432/diary_service
DIARY_SERVICE_REDIS_URL=redis://diary-redis:6379/0
DIARY_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
DIARY_SERVICE_IDENTITY_JWKS_URL=http://identity-service:8000/.well-known/jwks.json
DIARY_SERVICE_IDENTITY_ISSUER=identity-service

# Postgres (diary-db container)
DIARY_POSTGRES_DB=diary_service
DIARY_POSTGRES_USER=diary_service
DIARY_POSTGRES_PASSWORD=diary_service

# --- catalog-service ---
CATALOG_SERVICE_DATABASE_URL=postgresql+asyncpg://catalog_service:catalog_service@catalog-db:5432/catalog_service
CATALOG_SERVICE_REDIS_URL=redis://catalog-redis:6379/0
CATALOG_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Register a free key at https://fdc.nal.usda.gov/api-key-signup.html for
# real ingestion; DEMO_KEY is heavily rate-limited and fine for local dev
# smoke-testing only, never for a real bulk run.
CATALOG_SERVICE_USDA_FDC_API_KEY=DEMO_KEY
CATALOG_SERVICE_USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Postgres (catalog-db container)
CATALOG_POSTGRES_DB=catalog_service
CATALOG_POSTGRES_USER=catalog_service
CATALOG_POSTGRES_PASSWORD=catalog_service

# --- nutrition-calculation-service ---
NUTRITION_CALCULATION_SERVICE_DATABASE_URL=postgresql+asyncpg://nutrition_calculation_service:nutrition_calculation_service@nutrition-db:5432/nutrition_calculation_service
NUTRITION_CALCULATION_SERVICE_REDIS_URL=redis://nutrition-redis:6379/0
NUTRITION_CALCULATION_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
NUTRITION_CALCULATION_SERVICE_IDENTITY_JWKS_URL=http://identity-service:8000/.well-known/jwks.json
NUTRITION_CALCULATION_SERVICE_PROFILE_SERVICE_BASE_URL=http://profile-service:8000
# Per-caller credential for profile-service's internal reveal-metrics
# endpoint (implementation plan Addendum 1) -- local dev only, production
# value comes from Secrets Manager.
NUTRITION_CALCULATION_SERVICE_PROFILE_REVEAL_CREDENTIAL=dev-profile-reveal-credential-change-me

# Postgres (nutrition-db container)
NUTRITION_POSTGRES_DB=nutrition_calculation_service
NUTRITION_POSTGRES_USER=nutrition_calculation_service
NUTRITION_POSTGRES_PASSWORD=nutrition_calculation_service

# --- food-recognition-service ---
FOOD_RECOGNITION_SERVICE_DATABASE_URL=postgresql+asyncpg://food_recognition_service:food_recognition_service@food-recognition-db:5432/food_recognition_service
FOOD_RECOGNITION_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
FOOD_RECOGNITION_SERVICE_IDENTITY_JWKS_URL=http://identity-service:8000/.well-known/jwks.json
FOOD_RECOGNITION_SERVICE_CATALOG_SERVICE_BASE_URL=http://catalog-service:8000
# Metered, external Anthropic API key (implementation plan section 6(b))
# -- local dev only, production value comes from Secrets Manager. Never a
# real key in this tracked file.
FOOD_RECOGNITION_SERVICE_ANTHROPIC_API_KEY=dev-anthropic-api-key-change-me
FOOD_RECOGNITION_SERVICE_VISION_MODEL=claude-haiku-4-5
# Per-caller credential for catalog-service's internal lookup endpoint
# (implementation plan section 6(c)) -- local dev only, production value
# comes from Secrets Manager.
FOOD_RECOGNITION_SERVICE_CATALOG_LOOKUP_CREDENTIAL=dev-catalog-lookup-credential-change-me
# Product-facing feature knobs (implementation plan section 1 acceptance
# criterion 2, section 8.3 acceptance criterion 9).
FOOD_RECOGNITION_CONFIDENCE_THRESHOLD=0.6
FOOD_RECOGNITION_PHOTO_ANALYSIS_ENABLED=true

# Postgres (food-recognition-db container)
FOOD_RECOGNITION_POSTGRES_DB=food_recognition_service
FOOD_RECOGNITION_POSTGRES_USER=food_recognition_service
FOOD_RECOGNITION_POSTGRES_PASSWORD=food_recognition_service

# --- activity-service ---
ACTIVITY_SERVICE_DATABASE_URL=postgresql+asyncpg://activity_service:activity_service@activity-db:5432/activity_service
ACTIVITY_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
ACTIVITY_SERVICE_IDENTITY_JWKS_URL=http://identity-service:8000/.well-known/jwks.json

# Postgres (activity-db container)
ACTIVITY_POSTGRES_DB=activity_service
ACTIVITY_POSTGRES_USER=activity_service
ACTIVITY_POSTGRES_PASSWORD=activity_service

# --- profile-service ---
# NOTE: unlike every other service's docker-compose.yml block, this one
# does NOT hardcode PROFILE_SERVICE_RABBITMQ_URL in an `environment:`
# section -- composition_root.py's Settings.from_env() falls back to
# amqp://guest:guest@localhost/ if unset, which is unreachable from
# inside the container (there is no broker on the container's own
# loopback), so this .env value is the only thing that makes it correct.
PROFILE_SERVICE_DATABASE_URL=postgresql+asyncpg://profile_service:profile_service@profile-db:5432/profile_service
PROFILE_SERVICE_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# AWS KMS key id used to wrap/unwrap this service's per-user data
# encryption keys (README.md "Running locally") -- required, no default;
# a placeholder is sufficient for the service to boot -- only actual
# encrypt/decrypt calls (weight/body-metric/goal writes, the
# reveal-metrics endpoint) need a real key or a LocalStack/moto emulator
# reachable via PROFILE_SERVICE_KMS_ENDPOINT_URL (see docker-compose.yml).
PROFILE_SERVICE_KMS_KEY_ID=alias/profile-service-dev-key

# Postgres (profile-db container)
PROFILE_POSTGRES_DB=profile_service
PROFILE_POSTGRES_USER=profile_service
PROFILE_POSTGRES_PASSWORD=profile_service

# --- notification-service ---
NOTIFICATION_SERVICE_DATABASE_URL=postgresql+asyncpg://notification_service:notification_service@notification-db:5432/notification_service

# Postgres (notification-db container)
NOTIFICATION_POSTGRES_DB=notification_service
NOTIFICATION_POSTGRES_USER=notification_service
NOTIFICATION_POSTGRES_PASSWORD=notification_service

# --- billing-service ---
BILLING_SERVICE_DATABASE_URL=postgresql+asyncpg://billing_service:billing_service@billing-db:5432/billing_service

# Postgres (billing-db container)
BILLING_POSTGRES_DB=billing_service
BILLING_POSTGRES_USER=billing_service
BILLING_POSTGRES_PASSWORD=billing_service

# --- recipe-service ---
RECIPE_SERVICE_DATABASE_URL=postgresql+asyncpg://recipe_service:recipe_service@recipe-db:5432/recipe_service

# Postgres (recipe-db container)
RECIPE_POSTGRES_DB=recipe_service
RECIPE_POSTGRES_USER=recipe_service
RECIPE_POSTGRES_PASSWORD=recipe_service

# --- social-service ---
SOCIAL_SERVICE_DATABASE_URL=postgresql+asyncpg://social_service:social_service@social-db:5432/social_service

# Postgres (social-db container)
SOCIAL_POSTGRES_DB=social_service
SOCIAL_POSTGRES_USER=social_service
SOCIAL_POSTGRES_PASSWORD=social_service

# --- analytics-service ---
ANALYTICS_SERVICE_DATABASE_URL=postgresql+asyncpg://analytics_service:analytics_service@analytics-db:5432/analytics_service

# Postgres (analytics-db container)
ANALYTICS_POSTGRES_DB=analytics_service
ANALYTICS_POSTGRES_USER=analytics_service
ANALYTICS_POSTGRES_PASSWORD=analytics_service

# --- nutrition-assistant-service ---
NUTRITION_ASSISTANT_SERVICE_DATABASE_URL=postgresql+asyncpg://nutrition_assistant_service:nutrition_assistant_service@nutrition-assistant-db:5432/nutrition_assistant_service
# Real Anthropic key for the chat endpoint (docker-compose.yml references
# this same, non-prefixed var) -- local dev only, production value comes
# from Secrets Manager. Without one, every chat request fails closed with
# ASSISTANT_UNAVAILABLE (never a silent fallback to a fake response).
ANTHROPIC_API_KEY=dev-anthropic-api-key-change-me

# Postgres (nutrition-assistant-db container)
NUTRITION_ASSISTANT_POSTGRES_DB=nutrition_assistant_service
NUTRITION_ASSISTANT_POSTGRES_USER=nutrition_assistant_service
NUTRITION_ASSISTANT_POSTGRES_PASSWORD=nutrition_assistant_service

# bff-service intentionally has no section here -- it has no database, no
# message broker, and no other required env var (implementation plan
# section 2); every env var its docker-compose.yml block needs is already
# hardcoded there.
