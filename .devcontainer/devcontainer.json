{
  "name": "nutriapp",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "postCreateCommand": "pip install --user -r requirements.txt 2>/dev/null || echo 'requirements.txt aún no existe, se instalará más adelante'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "forwardPorts": [8000, 5173, 5432, 6333],
  "portsAttributes": {
    "8000": { "label": "FastAPI backend" },
    "5173": { "label": "Frontend (Vite/Next dev)" },
    "5432": { "label": "PostgreSQL" },
    "6333": { "label": "Qdrant" }
  }
}
